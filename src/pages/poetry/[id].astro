---
import BaseLayout from '../../layouts/BaseLayout.astro';
import poetryData from '../../data/generated/poetry-poems.json';
import { filterPoemLines, normalizeAuthor, normalizeTitle } from '../../lib/poetry';

export function getStaticPaths() {
  return poetryData.poems.map((poem) => ({
    params: { id: poem.id },
    props: { poem }
  }));
}

interface Poem {
  id: string;
  title: string;
  titleEn: string;
  author: string;
  authorEn: string;
  dates: string;
  stanzas: Array<{ zh: string[]; en: string[] }>;
}

const { poem } = Astro.props as { poem: Poem };
const title = normalizeTitle(poem.title, poem.author);
const author = normalizeAuthor(poem.author);
const stanzas = poem.stanzas
  .map((stanza) => ({
    ...stanza,
    zh: filterPoemLines(stanza.zh, { poemId: poem.id })
  }))
  .filter((stanza) => stanza.zh.length > 0);
---

<BaseLayout
  title={`${title} — ${author} | 文日小栈`}
  description={`${title}：${author} 的中英对照诗歌。`}
  type="article"
>
  <article class="poetry-page page-shell">
    <header class="poetry-header">
      <div class="poetry-heading" lang="zh-CN">
        <h1 class="poetry-title">{title}</h1>
        <div class="poetry-meta">
          <span>{author}</span>
          {poem.dates && <span>{poem.dates}</span>}
        </div>
      </div>
      <div class="poetry-heading" lang="en">
        <h2 class="poetry-title">{poem.titleEn}</h2>
        <div class="poetry-meta">
          <span>{poem.authorEn}</span>
          {poem.dates && <span>{poem.dates}</span>}
        </div>
      </div>
    </header>

    <div class="poetry-columns">
      {stanzas.map((stanza) => (
        <div class="poetry-stanza-pair">
          <section class="poetry-language" aria-label="中文">
            {stanza.zh.map((line) => (
              <div class="poetry-line">{line}</div>
            ))}
          </section>
          <section class="poetry-language" aria-label="English">
            {stanza.en.map((line) => (
              <div class="poetry-line">{line}</div>
            ))}
          </section>
        </div>
      ))}
    </div>
  </article>
</BaseLayout>
