---
import BaseLayout from '../../layouts/BaseLayout.astro';
import poetryData from '../../data/generated/poetry-poems.json';

export function getStaticPaths() {
  return poetryData.poems.map((poem) => ({
    params: { id: poem.id },
    props: { poem }
  }));
}

interface Poem {
  title: string;
  titleEn: string;
  author: string;
  authorEn: string;
  dates: string;
  stanzas: Array<{ zh: string[]; en: string[] }>;
}

const { poem } = Astro.props as { poem: Poem };
---

<BaseLayout
  title={`${poem.title} — ${poem.author} | 文日小栈`}
  description={`${poem.title}：${poem.author} 的中英对照诗歌。`}
  type="article"
>
  <article class="poetry-page page-shell">
    <a class="section-header__back" href="/">
      ← 返回首页
    </a>
    <header class="poetry-header">
      <h1>{poem.title}</h1>
      <p class="poetry-title-en">{poem.titleEn}</p>
      <div class="poetry-meta">
        <span>{poem.author}</span>
        <span>{poem.authorEn}</span>
        {poem.dates && <span>{poem.dates}</span>}
      </div>
    </header>

    <div class="poetry-columns">
      <section class="poetry-language" aria-label="中文">
        {poem.stanzas.map((stanza) => (
          <div class="poetry-stanza">
            {stanza.zh.map((line) => (
              <div class="poetry-line">{line}</div>
            ))}
          </div>
        ))}
      </section>
      <section class="poetry-language" aria-label="English">
        {poem.stanzas.map((stanza) => (
          <div class="poetry-stanza">
            {stanza.en.map((line) => (
              <div class="poetry-line">{line}</div>
            ))}
          </div>
        ))}
      </section>
    </div>
  </article>
</BaseLayout>
