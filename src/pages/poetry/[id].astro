---
import BaseLayout from '../../layouts/BaseLayout.astro';
import poetryData from '../../data/generated/poetry-poems.json';

export function getStaticPaths() {
  return poetryData.poems.map((poem) => ({
    params: { id: poem.id },
    props: { poem }
  }));
}

interface Poem {
  title: string;
  titleEn: string;
  author: string;
  authorEn: string;
  dates: string;
  stanzas: Array<{ zh: string[]; en: string[] }>;
}

const { poem } = Astro.props as { poem: Poem };
const sectionMarker = /^[一二三四五六七八九十百〇○零]{1,6}[、.]?$/;
const stanzas = poem.stanzas.map((stanza, index) => {
  let marker = '';
  let inlineMarker = '';
  const zh = [] as Array<{ text: string; marker: string }>;
  stanza.zh.forEach((line, lineIndex) => {
    const value = line.trim();
    if (lineIndex < stanza.zh.length - 1 && sectionMarker.test(value)) {
      if (lineIndex === 0) marker = value;
      else inlineMarker = value;
      return;
    }
    zh.push({ text: line, marker: inlineMarker });
    inlineMarker = '';
  });
  return {
    ...stanza,
    zh,
    marker: index === 0 && poem.title.startsWith(`${marker}、`) ? '' : marker
  };
});
---

<BaseLayout
  title={`${poem.title} — ${poem.author} | 文日小栈`}
  description={`${poem.title}：${poem.author} 的中英对照诗歌。`}
  type="article"
>
  <article class="poetry-page page-shell">
    <a class="section-header__back" href="/">
      ← 返回首页
    </a>
    <header class="poetry-header">
      <h1>{poem.title}</h1>
      <p class="poetry-title-en">{poem.titleEn}</p>
      <div class="poetry-meta">
        <span>{poem.author}</span>
        <span>{poem.authorEn}</span>
        {poem.dates && <span>{poem.dates}</span>}
      </div>
    </header>

    <div class="poetry-columns">
      {stanzas.map((stanza) => (
        <div class="poetry-stanza-pair">
          {stanza.marker && <div class="poetry-section-label">{stanza.marker}</div>}
          <section class="poetry-language" aria-label="中文">
            {stanza.zh.map((line) => (
              <div class="poetry-line">
                {line.marker && <span class="poetry-inline-marker">{line.marker}</span>}
                {line.text}
              </div>
            ))}
          </section>
          <section class="poetry-language" aria-label="English">
            {stanza.en.map((line) => (
              <div class="poetry-line">{line}</div>
            ))}
          </section>
        </div>
      ))}
    </div>
  </article>
</BaseLayout>
