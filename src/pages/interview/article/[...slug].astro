---
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionHeader from '../../../components/SectionHeader.astro';
import { getInterviews, interviewTopicUrl } from '../../../lib/interviews';
import { formatDate } from '../../../lib/content';

export async function getStaticPaths() {
  return (await getInterviews()).map((entry) => ({
    params: { slug: entry.id },
    props: { entry }
  }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const directory = entry.id.split('/').slice(0, -1).join(' / ');
---

<BaseLayout
  title={`${entry.data.title} | 面试八股`}
  description={entry.data.description || entry.data.title}
  type="article"
>
  <article class="article-shell">
    <a href="/interview/">← 返回文章</a>
    <SectionHeader title={entry.data.title} description={directory || undefined} />
    <div class="article-header-meta">
      <span>发布于 {formatDate(entry.data.date)}</span>
      <div class="tag-row">
        {entry.data.tags.map((tag) => (
          <a href={interviewTopicUrl(tag)}>{tag}</a>
        ))}
      </div>
    </div>
    <div class="article-content">
      <Content />
    </div>
  </article>
</BaseLayout>
