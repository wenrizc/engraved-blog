---
import { getImage, Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoCard from '../components/PhotoCard.astro';
import PhotoLightbox from '../components/PhotoLightbox.astro';
import PlateFrame from '../components/PlateFrame.astro';
import PostCard from '../components/PostCard.astro';
import { plates } from '../data/plates';
import { poetryQuotes } from '../data/poetryQuotes';
import { getPhotos, getPublishedArticles } from '../lib/content';

const posts = await getPublishedArticles();
const photos = await getPhotos();
const featured = posts[0];
const poemOptions = poetryQuotes.map(({ poemId, text, lines, author, work }) => ({
  poemId,
  text,
  lines,
  author,
  work
}));

// Hero plate follows the poem pattern: the first plate is rendered on the
// server, then a random one is swapped in on the client. srcset is precomputed
// for every plate so only the chosen image is fetched and shown in full.
const HERO_PLATE_WIDTHS = [480, 640, 960, 1280];
if (plates.length === 0) {
  throw new Error('No plates found. Run `npm run fetch:plates` to mirror the print collection.');
}
const plateOptions = await Promise.all(
  plates.map(async (plate) => {
    const optimized = await getImage({
      src: plate.image,
      widths: HERO_PLATE_WIDTHS,
      format: 'webp',
      quality: 82
    });
    // Full-size source for the zoom lightbox, mirroring the photo gallery.
    const full = await getImage({ src: plate.image, width: plate.image.width, format: 'webp' });
    return {
      title: plate.title,
      artist: plate.artist,
      alt: plate.alt,
      orientation: plate.orientation,
      src: optimized.src,
      srcset: optimized.srcSet.attribute,
      width: optimized.attributes.width,
      height: optimized.attributes.height,
      full: full.src
    };
  })
);
const heroPlate = plates[0];
---

<BaseLayout title="文日小栈 — 印痕" description="文日小栈：文章、摄影与日常观察。">
  <script is:inline>
    document.documentElement.classList.add('has-js');
  </script>
  <div class="masthead-wrap">
    <section class="masthead" aria-labelledby="site-title">
      <div class="masthead-copy">
        <h1 id="site-title">文日小栈</h1>
        <a
          class="masthead-poem"
          href={poemOptions[0] ? `/poetry/${poemOptions[0].poemId}/` : '/poetry/'}
          data-poems={JSON.stringify(poemOptions)}
          data-poem-pending
          aria-label="阅读诗歌"
        >
          <span class="poem-lines">
            {poemOptions[0]?.lines.map((line) => (
              <span class="poem-line">{line}</span>
            ))}
          </span>
          <span class="poem-meta">
            {poemOptions[0] &&
              `— ${poemOptions[0].author}${poemOptions[0].work ? `，${poemOptions[0].work}` : ''}`}
          </span>
        </a>
        <script is:inline>
          const poemLink = document.currentScript.previousElementSibling;
          if (poemLink instanceof HTMLAnchorElement) {
            try {
              const poems = JSON.parse(poemLink.dataset.poems || '[]');
              const lines = poemLink.querySelector('.poem-lines');
              const meta = poemLink.querySelector('.poem-meta');
              if (poems.length && lines && meta) {
                const poem = poems[Math.floor(Math.random() * poems.length)];
                poemLink.href = `/poetry/${poem.poemId}/`;
                lines.replaceChildren(
                  ...(Array.isArray(poem.lines) ? poem.lines : [poem.text]).map((line) => {
                    const element = document.createElement('span');
                    element.className = 'poem-line';
                    element.textContent = line;
                    return element;
                  })
                );
                meta.textContent = `— ${poem.author}${poem.work ? `，${poem.work}` : ''}`;
              }
            } finally {
              poemLink.removeAttribute('data-poem-pending');
            }
          }
        </script>
      </div>
      <PlateFrame
        class="hero-plate"
        style={`--plate-ratio: ${heroPlate.image.width / heroPlate.image.height}`}
        title={heroPlate.title}
        full={plateOptions[0].full}
        data-plates={JSON.stringify(plateOptions)}
        data-plate-pending="true"
      >
        <Image
          src={heroPlate.image}
          alt={heroPlate.alt}
          widths={HERO_PLATE_WIDTHS}
          sizes="(max-width: 760px) 90vw, 42vw"
          loading="eager"
          fetchpriority="high"
        />
      </PlateFrame>
      <script is:inline>
        (() => {
          const figure = document.querySelector('.hero-plate[data-plates]');
          if (!(figure instanceof HTMLElement)) return;
          const reveal = () => figure.removeAttribute('data-plate-pending');

          let options = [];
          try {
            options = JSON.parse(figure.dataset.plates || '[]');
          } catch {
            options = [];
          }

          const image = figure.querySelector('img');
          if (!options.length || !image) {
            reveal();
            return;
          }

          const plate = options[Math.floor(Math.random() * options.length)];
          if (plate.width > 0 && plate.height > 0) {
            figure.style.setProperty('--plate-ratio', String(plate.width / plate.height));
          }
          if (plate.srcset) image.setAttribute('srcset', plate.srcset);
          else image.removeAttribute('srcset');
          image.setAttribute('src', plate.src);
          image.alt = plate.alt;
          if (plate.width) image.width = plate.width;
          if (plate.height) image.height = plate.height;

          const trigger = figure.querySelector('[data-photo-lightbox-trigger]');
          if (trigger instanceof HTMLElement) {
            if (plate.full) trigger.setAttribute('data-photo-lightbox-src', plate.full);
            if (plate.title) trigger.setAttribute('aria-label', `放大${plate.title}`);
          }

          if (image.complete && image.naturalWidth > 0) {
            reveal();
            return;
          }
          let settled = false;
          const finish = () => {
            if (settled) return;
            settled = true;
            reveal();
          };
          image.addEventListener('load', finish, { once: true });
          image.addEventListener('error', finish, { once: true });
          setTimeout(finish, 1500);
        })();
      </script>
    </section>
  </div>

  <section class="home-content">
    <div class="feature-column">
      <header class="editorial-heading">
        <h2>文章</h2>
      </header>
      {featured ? (
        <article class="lead-story">
          <h3>
            <a href={`/article/${featured.slug}/`}>{featured.data.title}</a>
          </h3>
          <p class="story-description">{featured.data.description}</p>
          <div class="story-foot">
            <span>
              {new Intl.DateTimeFormat('zh-CN', {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
              }).format(featured.data.date)}
            </span>
          </div>
        </article>
      ) : (
        <p class="empty-note">新的篇章正在准备中。</p>
      )}
      <div class="secondary-stories">
        {posts.slice(1, 4).map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    </div>
    <div class="photo-column">
      <header class="editorial-heading">
        <h2>摄影</h2>
      </header>
      <div class="home-photo-grid">
        {photos.slice(0, 2).map((photo, index) => (
          <PhotoCard photo={photo} priority={index === 0} />
        ))}
      </div>
    </div>
  </section>
  <PhotoLightbox title="放大版画" />
</BaseLayout>
