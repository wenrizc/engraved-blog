---
interface Props {
  title?: string;
  artist?: string;
  full?: string;
  class?: string;
  [key: string]: unknown;
}
const { title, artist, full, class: className, ...rest } = Astro.props;
---

<figure class:list={['plate-frame', className]} {...rest}>
  <div class="plate-frame__image">
    <button
      class="photo-zoom-trigger plate-zoom-trigger"
      type="button"
      data-photo-lightbox-trigger
      data-photo-lightbox-src={full}
      aria-label={title ? `放大${title}` : '放大版画'}
    >
      <slot />
    </button>
  </div>
  {(title || artist) && (
    <figcaption class="plate-caption">
      {title && (
        <span class="plate-title" data-plate-title>
          {title}
        </span>
      )}
      {artist && (
        <span class="plate-artist" data-plate-artist>
          {artist}
        </span>
      )}
    </figcaption>
  )}
</figure>
