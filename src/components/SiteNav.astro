---
interface Props {
  interview?: boolean;
}
const { interview = false } = Astro.props;
const nav = interview
  ? [
      { href: '/interview/', label: '文章', en: 'ARTICLE' },
      { href: '/interview/topics/', label: '主题', en: 'TAGS' },
      { href: '/interview/search/', label: '搜索', en: 'SEARCH' }
    ]
  : [
      { href: '/', label: '首页', en: 'HOME' },
      { href: '/article/', label: '文章', en: 'ARTICLE' },
      { href: '/photography/', label: '摄影', en: 'PHOTOGRAPHY' },
      { href: '/tags/', label: '主题', en: 'TAGS' },
      { href: '/about/', label: '关于', en: 'ABOUT' }
    ];

const links = [
  {
    href: 'https://wenrizc.github.io/technical-article-site/',
    label: '技术文章收集站',
    external: true
  },
  { href: '/interview/', label: '面试八股', external: false }
];
---

<nav
  class:list={['site-nav', { 'interview-nav': interview }]}
  aria-label={interview ? '面试八股导航' : '主导航'}
>
  {nav.map((item) => {
    const current =
      item.href === '/'
        ? Astro.url.pathname === '/'
        : item.href === '/interview/'
          ? Astro.url.pathname.startsWith('/interview/') &&
            !['topics', 'search'].some((section) =>
              Astro.url.pathname.startsWith(`/interview/${section}/`)
            )
          : Astro.url.pathname.startsWith(item.href);
    return (
      <a
        href={item.href}
        aria-current={current ? 'page' : undefined}
        class:list={{ active: current }}
      >
        <span>{item.label}</span>
        <small>{item.en}</small>
      </a>
    );
  })}
  {!interview && (
    <div class="nav-links" data-nav-links>
      <button
        type="button"
        class="nav-links__trigger"
        aria-haspopup="true"
        aria-expanded="false"
        aria-controls="nav-links-menu"
      >
        <span>链接</span>
        <small>LINKS</small>
      </button>
      <div class="nav-links__menu" id="nav-links-menu">
        {links.map((link) => (
          <a
            href={link.href}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
            aria-label={link.external ? `${link.label}（新窗口打开）` : undefined}
            aria-current={
              !link.external && Astro.url.pathname.startsWith(link.href) ? 'page' : undefined
            }
          >
            <span>{link.label}</span>
            <span class="nav-links__arrow" aria-hidden="true">
              ↗
            </span>
          </a>
        ))}
      </div>
    </div>
  )}
</nav>

<script>
  document.querySelectorAll<HTMLElement>('[data-nav-links]').forEach((linksNav) => {
    const trigger = linksNav.querySelector<HTMLButtonElement>('.nav-links__trigger');
    if (!trigger) return;

    const setOpen = (open: boolean) => {
      linksNav.classList.toggle('is-open', open);
      trigger.setAttribute('aria-expanded', String(open));
    };

    trigger.addEventListener('click', () => {
      setOpen(!linksNav.classList.contains('is-open'));
    });

    document.addEventListener('click', (event) => {
      if (!linksNav.contains(event.target as Node)) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });
  });
</script>
