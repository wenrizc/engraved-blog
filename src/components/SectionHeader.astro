---
interface Props {
  title: string;
  subtitle?: string;
  description?: string;
}
const { title, subtitle, description } = Astro.props;
---

<header class="section-header">
  <div class="section-header__title">
    <h1>{title}</h1>
    {subtitle && <span>{subtitle}</span>}
  </div>
  {description && <p>{description}</p>}
</header>
