 "ellipsis_variant": [
  {
   "id": "198400120a1478",
   "author": "约翰·济慈",
   "work": "《“我恐惧，我可能就要停止呼吸”》",
   "text": "我将永远不可能再向你凝视，\n再在那没有回音的爱情的魅力里\n陶醉沉沦；—于是，我一人独自\n站立在广大世界的涯岸上，思考⋯⋯\n等爱情和名誉沉降为虚无缥缈。"
  }
 ],
