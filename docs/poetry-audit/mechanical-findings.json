 "unbalanced_quotes": [
  {
   "id": "204393209c97cd",
   "author": "奥斯卡·王尔德",
   "work": "《在维罗纳》",
   "open": 0,
   "close": 1,
   "text": "他已将你遗忘，在永恒的白昼里\n享受黄金城里极乐的一切。”—\n没有安宁：在我监狱盲目的铁窗背后，\n我拥有无人可以掠夺的财富，\n我的爱，以及星辰所有的荣光。"
  },
  {
   "id": "3863f4edec49bb",
   "author": "托马斯·哈代",
   "work": "《自然之问》",
   "open": 1,
   "close": 0,
   "text": "“是哪个巨大的弱智之徒，\n有能力创造，搅混，\n没能力照看关心，\n把我们塞进一个玩笑，交给意外摆布？"
  },
  {
   "id": "ce962d7cc68ce7",
   "author": "托马斯·哈代",
   "work": "《母亲在悲叹》",
   "open": 1,
   "close": 0,
   "text": "“并以自命为神的眼光\n挑我的缺陷，\n到处揭发说我粗心大意，\n说我有污点！"
  },
  {
   "id": "ac85d8e72c9a81",
   "author": "托马斯·哈代",
   "work": "《堕落的姑娘》",
   "open": 1,
   "close": 0,
   "text": "“哟！密莉亚，亲爱的，这可真希奇！\n谁料得到我会在城里碰见你？"
  },
  {
   "id": "5d77771bc099fe",
   "author": "托马斯·哈代",
   "work": "《误会》",
   "open": 1,
   "close": 0,
   "text": "她瞧瞧我，怜悯地微笑，\n然后对我说：\n“这么长时间你的辛劳，\n全是为 这个？"
  },
  {
   "id": "2e28250f3135f4",
   "author": "托马斯·哈代",
   "work": "《他杀死的人》",
   "open": 1,
   "close": 0,
   "text": "“假如他和我两个\n在一处老酒店相会，\n我们本该相邀同坐\n好好儿干上几杯！"
  },
  {
   "id": "c8c0486e336169",
   "author": "托马斯·哈代",
   "work": "《在勒尔沃思海湾》",
   "open": 2,
   "close": 1,
   "text": "“你看到那个人吗？”我瞧了一瞧\n答道：“看到了。那个搭船来的人，\n那船顺海峡而来，绕圣阿尔班角。"
  },
  {
   "id": "98f065e7720b4f",
   "author": "托马斯·哈代",
   "work": "《致小径上的露伊莎》",
   "open": 0,
   "close": 1,
   "text": "—啊，我记起了！\n都因那个漫不经心的他的‘缘’：\n当年不爱我；如今他爱我，在召唤！”"
  },
  {
   "id": "e23dc896aea5ed",
   "author": "罗伯特·弗罗斯特",
   "work": "《修墙》",
   "open": 2,
   "close": 1,
   "text": "他只是说：“墙高有睦邻。”\n春天使我头脑发热，我在想\n有可能我能让他明白一点：\n“为什么要睦邻？不是因为\n别人家里养着牛？这里没牛。"
  },
  {
   "id": "34671e60e8f44e",
   "author": "埃德加·李·马斯特斯",
   "work": "《卡尔·汉勃林》",
   "open": 0,
   "close": 1,
   "text": "瞧啊，脓汁淋漓的眼皮底下，\n她的睫毛早就烂掉；\n眼球萎缩，蒙上一层白膜；\n从她脸上可以见到\n一个濒死的灵魂那种疯狂—\n而群众明白了她为什么蒙上布带。”"
  },
  {
   "id": "991f83d3bda25b",
   "author": "罗宾森·杰弗斯",
   "work": "《爱野天鹅》",
   "open": 0,
   "close": 1,
   "text": "哦，模糊的破镜，它想要抓住\n壮美世界的，\n一种颜色，一条光影，\n没交好运的猎人，哦，蜡做的子弹，\n狮子的美，野天鹅的翼，翅翼的暴风。”"
  },
  {
   "id": "938a9688a7fb35",
   "author": "哈特·克兰",
   "work": "《北拉布拉多》",
   "open": 1,
   "close": 0,
   "text": "“从来没人来赢取你，\n或者让你闪光的\n胸脯上微微起点红晕？"
  },
  {
   "id": "02da4ed4853c93",
   "author": "罗伯特·勃朗宁",
   "work": "《骑马像和胸像》",
   "open": 1,
   "close": 0,
   "text": "“在我数到下一粒念珠以前，\n我就要逃到爱我的公爵那里，\n坐在他身边，嘲笑忧愁和伤感。"
  },
  {
   "id": "7a1e6d28687dde",
   "author": "泰戈尔",
   "work": "《开始》",
   "open": 2,
   "close": 1,
   "text": "“我是从哪儿来的？你，在哪儿把我捡起来的？”孩子问他的妈妈说。\n她把孩子紧紧地搂在胸前，半哭半笑地答道—\n“你曾被我当作心愿藏在我的心里，我的宝贝。"
  },
  {
   "id": "2dd225db61a9b5",
   "author": "泰戈尔",
   "work": "《云与波》",
   "open": 2,
   "close": 1,
   "text": "妈妈，住在云端的人对我唤道—\n“我们从醒的时候游戏到白日终止。\n“我们与黄金色的曙光游戏，我们与银白色的月亮游戏。”"
  },
  {
   "id": "50531828368440",
   "author": "罗伯特·彭斯",
   "work": "《印文纳斯的美丽姑娘》",
   "open": 1,
   "close": 0,
   "text": "“邓墨西荒原，邓墨西战场，\n邓墨西动了不吉利的刀兵！\n那一仗杀死了我慈爱的父亲，\n呵，父亲外还有弟兄三人！"
  },
  {
   "id": "80131ac1c4d4f7",
   "author": "威廉·华兹华斯",
   "work": "《我们是七个》",
   "open": 1,
   "close": 0,
   "text": "“你说有两个在康韦住着，\n有两个到了海上，\n却又说你们还有七个！"
  },
  {
   "id": "998b064df3f1e5",
   "author": "威廉·华兹华斯",
   "work": "《瀑布和野蔷薇》",
   "open": 1,
   "close": 0,
   "text": "“当花朵含苞，春天来到，\n我便在山石中间\n把花冠戴好，向你通报：\n艳阳天近在眼前！"
  },
  {
   "id": "3646e842b709d4",
   "author": "珀西·比希·雪莱",
   "work": "《日 落》",
   "open": 0,
   "close": 1,
   "text": "而是安息，果真那样无可怨尤，\n或是还活着，沉没在爱的海洋；\n哦，都愿我的墓志铭也像你的：\n安宁！”是她生前唯一的哀鸣。"
  },
  {
   "id": "3fa1bf433a64e8",
   "author": "珀西·比希·雪莱",
   "work": "《女催眠师语病人》",
   "open": 1,
   "close": 0,
   "text": "四\n“像携带着五月阵雨的云朵，\n我的灵魂在降落下甘霖，\n降给你，你哦枯萎的花朵！"
  },
  {
   "id": "4bca4119de6ab1",
   "author": "约翰·济慈",
   "work": "《冷酷的妖女》",
   "open": 1,
   "close": 0,
   "text": "“草地上我遇到一位姑娘，\n美丽妖冶像天仙的娇女，\n她头发曼长，腿脚轻捷，\n有一对狂放的眼珠。"
  },
  {
   "id": "8a052ed30ff7c7",
   "author": "约翰·济慈",
   "work": "《圣亚尼节前夕》",
   "open": 1,
   "close": 0,
   "text": "“快走！快走！矮个子希尔德布兰\n最近得了场热病，病中他诅咒\n你以及你的宗族、土地和家园：\n还有莫里斯勋爵，尽管白了头，\n却没有半点慈悲心—唉！赶快走！"
  },
  {
   "id": "5188aebcb720ef",
   "author": "威廉·莎士比亚",
   "work": "《99》",
   "open": 1,
   "close": 0,
   "text": "对着早开的紫罗兰，我这样责备：\n“你的香是哪儿来的，假如不是从\n我爱人呼吸里偷来的，可爱的盗贼？"
  },
  {
   "id": "65b48e5ab2e637",
   "author": "A. E. 豪斯曼",
   "work": "《八》",
   "open": 1,
   "close": 0,
   "text": "“我愿你有骨气使得你自负，\n有爱侣，不沾花惹草，\n我愿你秋天拉磨节 到来\n赛马场上运气好。"
  },
  {
   "id": "30c4ca34d73c11",
   "author": "A. E. 豪斯曼",
   "work": "《二十六》",
   "open": 1,
   "close": 0,
   "text": "在一年以前我的爱和我，\n当我们正沿着田野走过，\n矮墙边我听见一棵白杨树\n孤独地一个在高处自语：\n“啊，且吻且走的那是谁家郎？"
  },
  {
   "id": "422cae06d0a048",
   "author": "A. E. 豪斯曼",
   "work": "《三十四 新欢》",
   "open": 1,
   "close": 0,
   "text": "“啊，我真看见你头痛，你可能别缠着我？\n你也许有点点好处，不过你配我还不够。"
  },
  {
   "id": "fa74802975acd2",
   "author": "A. E. 豪斯曼",
   "work": "《四十三 不朽的部分》",
   "open": 1,
   "close": 0,
   "text": "每当我醒来和晨光重逢，\n或者在夜间躺下来入梦，\n总听见我骨头在自语自言，\n“又过了一晚，又过了一天！"
  },
  {
   "id": "d29f29a750ebba",
   "author": "A. E. 豪斯曼",
   "work": "《五十三 真情人》",
   "open": 1,
   "close": 0,
   "text": "“亲爱的，我从此再不来惹你\n看见我的脸生气，\n所以，趁东方露白以前\n来和我搂抱一会。"
  }
 ],
 "ascii_punct": [
