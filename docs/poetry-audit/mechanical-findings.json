 "short_quote": [
  {
   "id": "eb83390d28891c",
   "author": "罗伯特·弗罗斯特",
   "work": "《致解冻的风》",
   "text": "带着雨来吧，哦喧闹的西南风！"
  },
  {
   "id": "3a68e53f2df3db",
   "author": "威廉·卡洛斯·威廉斯",
   "work": "《红小车》",
   "text": "白色的鸡在旁边\n走着。"
  },
  {
   "id": "4c8058858e3819",
   "author": "E. E.肯明斯",
   "work": "《春天像一只或许的手》",
   "text": "决不会打破任何东西。"
  },
  {
   "id": "40e7f0b37f57fc",
   "author": "兰斯敦·休斯",
   "work": "《汤姆叔叔》",
   "text": "里面—\n是被揍扁的骄傲。"
  },
  {
   "id": "42e49f49ce58da",
   "author": "埃德加·爱伦·坡",
   "work": "《“深眠黄土”》",
   "text": "吾爱深眠黄土，\n余唯向隅而泣。"
  },
  {
   "id": "c928cb83423705",
   "author": "埃德加·爱伦·坡",
   "work": "《致—（“曾几何时”）》",
   "text": "笔从我颤抖的手中无力地落地。"
  },
  {
   "id": "9e07592d79725a",
   "author": "狄兰·托马斯",
   "work": "《而死亡也一统不了天下》",
   "text": "而死亡也一统不了天下。"
  },
  {
   "id": "5e53a73e26bedf",
   "author": "威廉·华兹华斯",
   "work": "《致海登，观其所绘《拿破仑在圣赫勒拿岛》》",
   "text": "迎候着他的是千秋万世的黎明。"
  },
  {
   "id": "b31b166a8e194a",
   "author": "约翰·济慈",
   "work": "《秋 颂》",
   "text": "春歌在哪里？哎，春歌在哪里？"
  },
  {
   "id": "e718e2b904ffa6",
   "author": "艾米莉·狄金森",
   "work": "《我为美而死，对坟墓》",
   "text": "他轻声问我“为什么倒下？”"
  },
  {
   "id": "89da7bafbaef85",
   "author": "艾米莉·狄金森",
   "work": "《亲爱的三月，请进》",
   "text": "是谁敲门？准是四月。"
  },
  {
   "id": "60f9ff9612309a",
   "author": "威廉·莎士比亚",
   "work": "《18》",
   "text": "我能否把你比做夏季的一天？"
  }
 ]
